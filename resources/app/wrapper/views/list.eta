<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8"/>
		<link rel="icon" href="/favicon.ico" type="image/png"/>
		<title>Video List - Wrapper: Offline</title>
		<meta name="description" content="Wrapper: Offline's Video List"/>
		<link rel="stylesheet" type="text/css" href="/pages/css/global.css">
		<link rel="stylesheet" type="text/css" href="/pages/css/list.css">
		<script src="/pages/js/jquery.js"></script>
		<script src="/pages/js/global.js"></script>
	</head>

	<body>
		<%~ includeFile("./includes/header", { env: it.env }) %>

		<main>
			<div class="list-heading">
				<div>
					<h1>My Videos</h1>
					<p>Pick up where you left off or start something new.</p>
				</div>
				<label class="list-sort" for="video-sort">
					<span>Sort by</span>
					<select id="video-sort">
						<option value="newest">Recently modified</option>
						<option value="oldest">Oldest modified</option>
						<option value="title-asc">Title (A-Z)</option>
						<option value="title-desc">Title (Z-A)</option>
					</select>
				</label>
			</div>
			<table class="full_screen">
				<thead>
					<tr>
						<td></td>
						<td>Video Title</td>
						<td>Last Modified</td>
						<td></td>
					</tr>
				</thead>
				<tbody></tbody>
				<tfoot>
					<tr>
						<td colspan="127"><a id="load_more" href="javascript:;">LOAD MORE...</a></td>
					</tr>
				</tfoot>
			</table>
		</main>

		<%~ includeFile("./includes/footer", { env: it.env }) %>
	</body>

	<script>
		let movies = [];
		const tbody = $("tbody");
		const loadMore = $("#load_more");
		const sortControl = document.getElementById("video-sort");
		const videoTable = document.querySelector("table.full_screen");
		const savedSort = localStorage.getItem("VIDEO_SORT_ORDER") || "newest";
		const validSorts = ["newest", "oldest", "title-asc", "title-desc"];
		sortControl.value = validSorts.includes(savedSort) ? savedSort : "newest";
		videoTable.classList.toggle("compact", localStorage.getItem("COMPACT_VIDEO_LIST") == "true");

		let C = 0;
		function loadRows() {
			const sortedMovies = movies.slice().sort((a, b) => {
				if (sortControl.value.startsWith("title")) {
					const compare = String(a.title || "").localeCompare(String(b.title || ""));
					return sortControl.value == "title-desc" ? -compare : compare;
				}
				const dateA = Date.parse(a.date) || 0;
				const dateB = Date.parse(b.date) || 0;
				return sortControl.value == "oldest" ? dateA - dateB : dateB - dateA;
			});
			// load only 69 rows
			let c = C;
			C += 69;
			for (; c < C; c++) {
				// we reached the end
				if (c > sortedMovies.length - 1) {
					loadMore.remove();
					break;
				}

				const tbl = sortedMovies[c];
				// make the date and time less confusing to read
				const date = tbl.date.split("T")[0];
				const time = tbl.date.split("T")[1].substring(0, 8);
				const id = escapeHtml(tbl.id);
				const title = escapeHtml(tbl.title);
				const duration = escapeHtml(tbl.duration);
				const encodedId = encodeURIComponent(tbl.id);

				tbody.append(
					`<tr id="${id}">
						<td>
							<img src="/file/movie/thumb/${encodedId}" alt="Video thumbnail"/>
						</td>
						<td>
							<div>${title}</div>
							<div>${duration}</div>
						</td>
						<td>
							<span>${escapeHtml(date)}, ${escapeHtml(time)}</span>
						</td>
						<td>
							<a href="#" data-action="preview" aria-label="Preview video"></a>
							<a href="/go_full?movieId=${encodedId}" aria-label="Edit video"></a>
							<a href="/file/movie/file/${encodedId}" download="${escapeHtml(tbl.title)}.zip" aria-label="Download video"></a>
							<a href="#" data-action="repair" aria-label="Repair video"></a>
							<a href="#" data-action="delete" aria-label="Delete video"></a>
						</td>
					</tr>`.trim()
				);
			}
		}

		function escapeHtml(value) {
			return String(value == null ? "" : value)
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#39;");
		}

		loadMore.onclick = loadRows;

		$.get("/api/movies/list", data => {
			movies = data;
			loadRows();
		});
		sortControl.addEventListener("change", () => {
			localStorage.setItem("VIDEO_SORT_ORDER", sortControl.value);
			C = 0;
			tbody.empty();
			loadMore.show();
			loadRows();
		});
		tbody.on("click", "a[data-action]", event => {
			event.preventDefault();
			const action = $(event.target).closest("a").attr("data-action");
			const id = $(event.target).closest("tr").attr("id");
			if (action == "preview") popup(id);
			else destructive(id, action);
		});

		function destructive(mId, act) {
			const yesno = confirm(`Are you sure you want to ${act} movie #${mId}?`);

			if (yesno)
				$.get(`/api/movie/${act}/${mId}`, data => {
					if (data.status == "ok") {
						switch (act) {
							case "repair":
								window.location = `/player?movieId=${mId}`;
								break;
							case "delete":
								$(document.getElementById(mId)).fadeOut(() => $(document.getElementById(mId)).remove());
								break;
						}
					} else alert("Guess you're stuck with your movie.");
				});
		}

		function popup(id) {
			window.open('/player?movieId=' + id, 'MsgWindow', 'width=1280,height=720,left=' + (screen.width / 2 - 640) +
				',top=' + (screen.height / 2 - 360));
		}

	</script>

</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Goofy Raid Flash</title>
<style>
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }
    body {
        background-color: black;
        display: flex;
        justify-content: center;
        align-items: center;
        animation: flashBg 0.2s infinite alternate;
    }
    h1 {
        font-size: 4rem;
        font-family: Arial, sans-serif;
        color: blue;
        animation: flashText 0.2s infinite alternate;
    }

    /* background flashing red/black */
    @keyframes flashBg {
        0% { background-color: black; }
        100% { background-color: red; }
    }

    /* text flashing blue/green */
    @keyframes flashText {
        0% { color: blue; }
        100% { color: green; }
    }
</style>
</head>
<body>

<h1>FUCKED LVM</h1>

</body>
</html>
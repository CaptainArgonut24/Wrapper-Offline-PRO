<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8"/>
		<link rel="icon" href="/favicon.ico" type="image/png" />
		<title>Settings - Wrapper: Offline</title>
		<meta name="description" content="Wrapper: Offline's settings"/>
		<link rel="stylesheet" type="text/css" href="/pages/css/global.css"/>
		<link rel="stylesheet" type="text/css" href="/pages/css/importer.css"/>
		<script src="/pages/js/jquery.js"></script>
		<script src="/pages/js/global.js"></script>
		<script>const IS_STUDIO = false;</script>
	</head>

	<body>
		<%~ includeFile("./includes/header", { env: it.env }) %>

		<main>
			<div class="settings-intro">
				<h1>Settings</h1>
				<p>Adjust how Wrapper: Offline looks and works on this device.</p>
			</div>
			<nav class="tabs_contain">
				<div class="tab_buttons">
					<h2>Preferences</h2>
					<a href="#features" class="selected" data-triggers="0">Features</a>
					<a href="#appearance" data-triggers="1">Appearance</a>
					<a href="#workspace" data-triggers="2">Video Workspace</a>
					<a href="#export" data-triggers="3">Export</a>
					<a href="#library" data-triggers="4">Your Library</a>
				</div>
				<nav class="tab" style="display:block">
					<h2>Features</h2>
					<div class="setting-list">
						<section class="setting-card">
							<div>
								<h3>Discord rich presence</h3>
								<p>Show Wrapper: Offline as your current activity in Discord.</p>
							</div>
							<input class="setting" type="checkbox" id="DISCORD_RPC"/>
						</section>
						<section class="setting-card">
							<div>
								<h3>Truncated theme list</h3>
								<p>Show a shorter list of themes in the video maker.</p>
							</div>
							<input class="setting" type="checkbox" id="TRUNCATED_THEMELIST"/>
						</section>
						<section class="setting-card">
							<div>
								<h3>Show audio waveforms</h3>
								<p>Generate detailed audio waveforms in the editor. Disabling this can improve responsiveness.</p>
							</div>
							<input class="setting" type="checkbox" id="SHOW_WAVEFORMS"/>
						</section>
						<section class="setting-card">
							<div>
								<h3>Default watermark</h3>
								<p>Choose which watermark appears when using the Go!Animate watermark.</p>
							</div>
							<select class="setting" id="DEFAULT_WATERMARK">
								<option value="default">GoAnimate</option>
								<option value="twoLines">Go Make Your Own</option>
								<option value="g4s">GoAnimate For Schools</option>
								<option value="freeTrial">Free Trial</option>
							</select>
						</section>
						<section class="setting-card">
							<div>
								<h3>Video aspect ratio</h3>
								<p>Set the default player aspect ratio.</p>
							</div>
							<select class="setting" id="IS_WIDE">
								<option value="0">14:9</option>
								<option value="1">16:9</option>
							</select>
						</section>
						<section class="setting-card">
							<div>
								<h3>Default theme</h3>
								<p>Choose the theme used by “Start with your default theme” on the video creation page.</p>
							</div>
							<select class="setting" id="DEFAULT_THEME" data-local="true" data-default="custom">
								<option value="custom">Comedy World</option>
								<option value="action">Lil' Peepz</option>
								<option value="business">Business Friendly</option>
								<option value="retro">Cartoon Classics</option>
								<option value="politics2">White Houserz</option>
								<option value="stick">Stick Figure</option>
								<option value="anime">Anime</option>
								<option value="ninjaanime">Ninja Anime</option>
								<option value="spacecitizen">Space Citizens</option>
								<option value="chibi">Chibi Peepz</option>
								<option value="ninja">Chibi Ninjas</option>
								<option value="animal">Lil' Petz World</option>
								<option value="space">Space Peepz</option>
								<option value="fullenergy">Full Energy</option>
								<option value="politic">Politics &amp; Celebrity</option>
								<option value="bizmodels">Business Models</option>
								<option value="sticklybiz">Stickly Business</option>
								<option value="christmas">Holiday &amp; Seasonal</option>
								<option value="monstermsh">Monsters Mayhem</option>
								<option value="akon">AKON</option>
								<option value="ben10">Ben 10</option>
								<option value="botdf">Blood on the Dance Floor</option>
								<option value="bunny">It's Happy Bunny</option>
								<option value="chowder">Chowder</option>
								<option value="domo">Domo</option>
								<option value="monkeytalk">SuperRica &amp; Rashy</option>
								<option value="sf">Street Fighter</option>
								<option value="startrek">Star Trek Quogs</option>
								<option value="toonadv">Toon Adventure</option>
								<option value="underdog">Underdog</option>
								<option value="willie">Willie Nelson</option>
								<option value="street">Street</option>
							</select>
						</section>
						<section class="setting-card">
							<div>
								<h3>Video list sort order</h3>
								<p>Choose the default order for videos on the home page.</p>
							</div>
							<select class="setting" id="VIDEO_SORT_ORDER" data-local="true" data-default="newest">
								<option value="newest">Recently modified</option>
								<option value="oldest">Oldest modified</option>
								<option value="title-asc">Title (A-Z)</option>
								<option value="title-desc">Title (Z-A)</option>
							</select>
						</section>
						<section class="setting-card">
							<div>
								<h3>Compact video cards</h3>
								<p>Show smaller thumbnails and fit more videos on screen.</p>
							</div>
							<input class="setting" type="checkbox" id="COMPACT_VIDEO_LIST" data-local="true" data-default="false"/>
						</section>
						<section class="setting-card">
							<div>
								<h3>Remember video list filters</h3>
								<p>Keep the selected library or archive view and folder filter when you return.</p>
							</div>
							<input class="setting" type="checkbox" id="REMEMBER_VIDEO_FILTERS" data-local="true" data-default="true"/>
						</section>
					</div>
				</nav>
				<nav class="tab">
					<h2>Appearance</h2>
					<div class="setting-list">
						<section class="setting-card">
							<div>
								<h3>Dark mode</h3>
								<p>Use a dark color scheme across Wrapper: Offline pages.</p>
							</div>
							<input class="setting" type="checkbox" id="DARK_MODE" data-local="true" data-default="false"/>
						</section>
					</div>
				</nav>
				<nav class="tab">
					<h2>Video Workspace</h2>
					<div class="setting-list">
						<section class="setting-card">
							<div>
								<h3>Video Layout</h3>
								<p>Choose how video projects are arranged in My Videos.</p>
							</div>
							<select class="setting" id="VIDEO_LAYOUT" data-local="true" data-default="vertical">
								<option value="vertical">Vertical cards</option>
								<option value="horizontal">Horizontal rows</option>
							</select>
						</section>
						<section class="setting-card theme-visibility-card">
							<div>
								<h3>Theme Visibility</h3>
								<p>Choose which themes appear on the video creation page. All themes are enabled by default.</p>
								<div class="theme-visibility-actions">
									<button id="themes-enable-all" type="button">Enable all</button>
									<button id="themes-disable-all" type="button">Disable all</button>
								</div>
							</div>
							<div id="theme-visibility-options" class="theme-visibility-options"></div>
						</section>
					</div>
				</nav>
				<nav class="tab">
					<h2>Export</h2>
					<div class="setting-list">
						<section class="setting-card">
							<div>
								<h3>GoExport installation</h3>
								<p>Set an absolute path to GoExport.exe or the GoExport main.py entry point. Python source installs use the Python command available on PATH.</p>
							</div>
							<input class="setting" type="text" id="GOEXPORT_PATH" placeholder="C:\Tools\GoExport\GoExport.exe"/>
						</section>
						<section class="setting-card">
							<div>
								<h3>GoExport Python command</h3>
								<p>Used only when the installation path points to main.py. Set this to your Python 3.13 executable if it is not available as “python” on PATH.</p>
							</div>
							<input class="setting" type="text" id="GOEXPORT_PYTHON" placeholder="python"/>
						</section>
						<section class="setting-card">
							<div>
								<h3>GoExport setup guide</h3>
								<p>GoExport requires a compatible Flash-enabled Chromium runtime and FFmpeg. Install and configure it before exporting.</p>
							</div>
							<div class="setting-link-list">
								<a class="setting-link" href="https://goexport.lexian.dev/" target="_blank" rel="noopener noreferrer">Documentation</a>
								<a class="setting-link" href="https://github.com/GoExport/GoExport" target="_blank" rel="noopener noreferrer">GitHub repository</a>
							</div>
						</section>
					</div>
				</nav>
				<nav class="tab">
					<h2>Your Library</h2>
					<nav id="importer">
						<nav id="import_head">
							<button id="import-toggle" onclick="document.getElementById('importer-files').click()" class="import-button">Upload files</button>
							<form>
								<input id="importer-files" type="file" name="file" title="Upload Files" accept=".mp3,.wav,.ogg,.wma,.swf,.gif,.png,.jpg,.mp4" style="display:none" />
							</form>
						</nav>
						<div id="importer-queue"></div>
					</nav>
					<section class="library-assets" aria-live="polite">
						<h3>Your uploaded assets</h3>
						<div class="library-controls">
							<label for="library-search">Search</label>
							<input id="library-search" type="search" placeholder="Search uploaded content..." autocomplete="off"/>
							<label for="library-category">Category</label>
							<select id="library-category"></select>
						</div>
						<div id="library-asset-list" class="library-list"></div>
						<div class="library-pagination" aria-label="Uploaded content pages">
							<button id="library-previous" type="button">Previous</button>
							<span id="library-page" aria-live="polite"></span>
							<button id="library-next" type="button">Next</button>
						</div>
					</section>
				</nav>
			</nav>
		</main>

		<div id="library-preview" class="library-preview" role="dialog" aria-modal="true" aria-labelledby="library-preview-title" hidden>
			<div class="library-preview-panel">
				<div class="library-preview-heading">
					<h3 id="library-preview-title"></h3>
					<button id="library-preview-close" type="button" aria-label="Close preview">×</button>
				</div>
				<div id="library-preview-content" class="library-preview-content"></div>
			</div>
		</div>

		<%~ includeFile("./includes/footer", { env: it.env }) %>
	</body>

	<script src="/pages/js/importer.js"></script>
	<script src="/pages/js/filesize.js"></script>
	<script src="/pages/js/library.js"></script>
	<script>
		new AssetImporter(importer);
		// this is a mess of type conversion

		/**
		 * list
		 */
		let list = [];
		for (const elem of $(".setting")) list.push(elem.id);

		$.getJSON("/api/settings/list", (d) => {
			for (const [key, val] of Object.entries(d)) {
				const index = list.indexOf(key);
				if (index < 0) {
					continue;
				}
				list.splice(index, 1);
				show(key, val);
			}
			// get local settings
			list.forEach((key) => {
				const elem = $(`#${key}`);
				const saved = localStorage.getItem(key);
				const value = saved === null ? elem.attr("data-default") : saved;
				show(key, elem.is("select, input[type='text']") ? value : value == "true");
			});
		}).fail(() => alert("Unable to load settings. Please restart the app and try again."));
		/**
		 * toggle
		 */
		$(".setting").on("change", (event) => {
			const elem = $(event.target);
			const setting = elem.attr("id");
			const value = elem.is("select, input[type='text']") ?
				elem.val() : elem.prop("checked");

			if (elem.attr("data-local") == "true") {
				if (elem.attr("id") == "DARK_MODE") toggleDarkMode(value);
				localStorage.setItem(setting, value);
			} else {
				$.post("/api/settings/update", { setting, value })
					.done((d) => {
						if (d.status != "ok") {
							alert("That didn't work.");
							return;
						}
					})
					.fail(() => alert("Could not save this setting. Please try again."));
			}
			show(setting, value);
		});

		function show(key, value) {
			const elem = $(`#${key}`);

			if (elem.is("select")) {
				elem.find(`option[value='${value}']`).prop("selected", true);
			} else if (elem.is("input[type='text']")) {
				elem.val(value || "");
			} else {
				elem.prop("checked", value);
			}
		}
	</script>
	<script>
	(() => {
		const themes = [
			["custom", "Comedy World"], ["action", "Lil' Peepz"],
			["business", "Business Friendly"], ["retro", "Cartoon Classics"],
			["politics2", "White Houserz"], ["stick", "Stick Figure"],
			["anime", "Anime"], ["ninjaanime", "Ninja Anime"],
			["spacecitizen", "Space Citizens"], ["chibi", "Chibi Peepz"],
			["ninja", "Chibi Ninjas"], ["animal", "Lil' Petz World"],
			["space", "Space Peepz"], ["fullenergy", "Full Energy"],
			["politic", "Politics & Celebrity"], ["bizmodels", "Business Models"],
			["sticklybiz", "Stickly Business"], ["christmas", "Holiday & Seasonal"],
			["monstermsh", "Monsters Mayhem"], ["akon", "AKON"],
			["ben10", "Ben 10"], ["botdf", "Blood on the Dance Floor"],
			["bunny", "It's Happy Bunny"], ["chowder", "Chowder"],
			["domo", "Domo"], ["monkeytalk", "SuperRica & Rashy"],
			["sf", "Street Fighter"], ["startrek", "Star Trek Quogs"],
			["toonadv", "Toon Adventure"], ["underdog", "Underdog"],
			["willie", "Willie Nelson"], ["street", "Street"]
		];
		const options = document.getElementById("theme-visibility-options");
		let visibility = {};
		try {
			visibility = JSON.parse(localStorage.getItem("THEME_VISIBILITY") || "{}");
			if (!visibility || typeof visibility != "object" || Array.isArray(visibility)) visibility = {};
		} catch (error) {
			visibility = {};
		}

		function saveVisibility() {
			visibility = Object.fromEntries(
				[...options.querySelectorAll("input[data-theme-id]")].map(input =>
					[input.dataset.themeId, input.checked]
				)
			);
			localStorage.setItem("THEME_VISIBILITY", JSON.stringify(visibility));
		}

		for (const [id, label] of themes) {
			const wrapper = document.createElement("label");
			wrapper.className = "theme-visibility-option";
			const input = document.createElement("input");
			input.type = "checkbox";
			input.dataset.themeId = id;
			input.checked = visibility[id] !== false;
			input.addEventListener("change", saveVisibility);
			const text = document.createElement("span");
			text.textContent = label;
			wrapper.append(input, text);
			options.append(wrapper);
		}
		document.getElementById("themes-enable-all").addEventListener("click", () => {
			options.querySelectorAll("input[data-theme-id]").forEach(input => input.checked = true);
			saveVisibility();
		});
		document.getElementById("themes-disable-all").addEventListener("click", () => {
			options.querySelectorAll("input[data-theme-id]").forEach(input => input.checked = false);
			saveVisibility();
		});
	})();
	</script>
</html>

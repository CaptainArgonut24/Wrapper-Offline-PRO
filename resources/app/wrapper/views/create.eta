    <body class="en_US">
        <div class="page-container">
            <div class="site-header">
                <div class="site-header-bg">
                </div>
                <div class="container site-header-inside">
                    <a class="site-logo" href="http://localhost:4343"
                    title="Wrapper: Offline">
                        <img alt="Make a Video Offline with Wrapper: Offline" src="http://localhost:4343/pages/img/logo.png"
                        />
                    </a>
                    <div class="pull-right">
                        <ul id="top-nav" class="top-nav">
                            <li>
                                <a href="http://localhost:4343/videolist">
                                    Your Videos
                                </a>
                            </li>
                            <li class="divider">
                            </li>
                        </ul>
                        <div class="top-nav-vm-btn">
                            <a class="btn btn-orange pull-left" href="http://localhost:4343/create">
                                Create
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="vm-bf-wrapper">
                <div class="vm-bf" id="topbanner-bf">
                    <div class="container">
                        <h1>
                            Create Any Animated Video.
                        </h1>
                        <p class="subtitle">
                            <strong>
                                Everything you need in a wide range of styles
                            </strong>
                        </p>
                        <div class="vm-bf-content">
                            <p>
                                Our themes are carefully produced sets of matching assets, such as characters,
                                actions, backgrounds, props and scene starters - each with a unique visual
                                style. Our flagship theme, Business Friendly, offers the widest selection,
                                providing hundreds of actions across numerous occupations and activities.
                            </p>
                            <div class="actions">
                                <a href="http://localhost:4343/go_full?tray=business&lid=13">
                                    <button class="btn-flat btn-flat-orange btn-flat-banner" type="button"
                                    data-theme="Start From Scratch" data-app-type="Video Maker"
                                    data-button-text="Video Maker"
                                    title="Video Maker">
                                        Make a Video
                                        <small>
                                            Start From Scratch
                                        </small>
                                    </button>
                                </a>
                                <a href="http://localhost:4343/cc_browser?themeId=business">
                                    <button class="btn-flat vm-bf-cc" type="button"
                                    data-theme="Business Friendly" data-app-type="Character Creator" data-button-text="Character Creator"
                                    title="Character Creator">
                                        <i class="i-cc-large">
                                        </i>
                                    </button>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container themes-section">
                <div class="header">
                    <div class="header-content">
                        <h2>
                            Select A Theme
                        </h2>
                        Select a theme based on its visual style, or use the filter to choose
                        based on features.
                    </div>
                    <div class="filter-dropdown-container">
                        <div class="filter-dropdown dropdown">
                            <a class="filter-dropdown-toggle" data-toggle="dropdown" href="#">
                                Filter Themes
                                <span class="caret">
                                </span>
                            </a>
                            <ul class="dropdown-menu pull-right" role="menu" aria-labelledby="dLabel">
                                <li>
                                    <a class="filter-item" href="#" data-filter="lipsync">
                                        <div class="filter-icon">
                                            <img src="http://localhost:4343/static/ad44370a650793d9/go/img/videomaker/filter_lip.png"
                                            alt="">
                                        </div>
                                        <div class="filter-body">
                                            <div class="filter-name">
                                                <strong>
                                                    Lip-sync
                                                </strong>
                                            </div>
                                            <span class="filter-desc">
                                                Characters automatically lip-sync their dialog when lines are assigned
                                                to them.
                                            </span>
                                        </div>
                                        <div class="filter-checkbox-container">
                                            <span class="filter-checkbox">
                                            </span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="filter-item" href="#" data-filter="ext_lib">
                                        <div class="filter-icon">
                                            <img src="http://localhost:4343/static/ad44370a650793d9/go/img/videomaker/filter_library.png"
                                            alt="">
                                        </div>
                                        <div class="filter-body">
                                            <div class="filter-name">
                                                <strong>
                                                    Extensive Library
                                                </strong>
                                            </div>
                                            <span class="filter-desc">
                                                Collections of characters, backgrounds and props corresponding to a wide
                                                variety of locations, occupations and industries.
                                            </span>
                                        </div>
                                        <div class="filter-checkbox-container">
                                            <span class="filter-checkbox">
                                            </span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="filter-item" href="#" data-filter="starters">
                                        <div class="filter-icon">
                                            <img src="http://localhost:4343/static/ad44370a650793d9/go/img/videomaker/filter_starter.png"
                                            alt="">
                                        </div>
                                        <div class="filter-body">
                                            <div class="filter-name">
                                                <strong>
                                                    Scene Starters
                                                </strong>
                                            </div>
                                            <span class="filter-desc">
                                                Pre-made sequences that help you get started (or finished) quickly! You
                                                can also save your own frequently-used sequences as starters.
                                            </span>
                                        </div>
                                        <div class="filter-checkbox-container">
                                            <span class="filter-checkbox">
                                            </span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="filter-item" href="#" data-filter="qvm">
                                        <div class="filter-icon">
                                            <img src="http://localhost:4343/static/ad44370a650793d9/go/img/videomaker/filter_template.png"
                                            alt="">
                                        </div>
                                        <div class="filter-body">
                                            <div class="filter-name">
                                                <strong>
                                                    Template
                                                </strong>
                                            </div>
                                            <span class="filter-desc">
                                                Super-fast tool for creating simple, dialog-based videos. Be finished
                                                in minutes!
                                            </span>
                                        </div>
                                        <div class="filter-checkbox-container">
                                            <span class="filter-checkbox">
                                            </span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="filter-item" href="#" data-filter="char_creator">
                                        <div class="filter-icon">
                                            <img src="http://localhost:4343/static/ad44370a650793d9/go/img/videomaker/filter_cc.png"
                                            alt="">
                                        </div>
                                        <div class="filter-body">
                                            <div class="filter-name">
                                                <strong>
                                                    Character Creator
                                                </strong>
                                            </div>
                                            <span class="filter-desc">
                                                Customize your characters! Adapt existing characters to meet your needs
                                                or build completely from scratch.
                                            </span>
                                        </div>
                                        <div class="filter-checkbox-container">
                                            <span class="filter-checkbox">
                                            </span>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="filter-results" id="filter-results" style="display:none">
                    <b class="filter-count">
                        0
                    </b>
                    matching themes based on filters:
                    <ul class="filter-crumb-list">
                    </ul>
                    <a class="filter-crumb-list-clear" href="#">

<footer>
	<nav id="foot-left">
		<a>v<%= it.env.WRAPPER_VER %></a>
		<a href="/settings">Settings</a>
		<a href="/FAQ">FAQ</a>
		<a href="https://www.google.com/" data-browser-link>Google Search</a>
		<a href="https://forms.gle/s8ecJvoKSeW2S2fT9" data-browser-link>Web Broweser</a>
		<a href="https://discord.gg/wrapper-offline-699004329998417932" data-browser-link data-discord-link>Main Wrapper Offline Discord</a>
		<a href="https://discord.gg/flashthemes" data-browser-link data-discord-link>Flash Themes Discord</a>
		<a href="https://forms.gle/s8ecJvoKSeW2S2fT9" data-browser-link>Bug Report</a>
	</nav>

	<nav id="foot-right"></nav>
</footer>
<script>
	document.querySelectorAll("footer a[data-browser-link]").forEach(link => {
		link.addEventListener("click", event => {
			event.preventDefault();
			if (link.hasAttribute("data-discord-link") &&
				!window.confirm("Discord will open in Wrapper's built-in browser. Continue?")) {
				return;
			}
			const browserUrl = new URL("/browser", window.location.origin);
			browserUrl.searchParams.set("startUrl", link.href);
			browserUrl.searchParams.set("startTitle", link.textContent.trim());
			if (link.hasAttribute("data-discord-link")) {
				browserUrl.searchParams.set("discordConfirmed", "1");
			}
			window.open(browserUrl.href, "_blank");
		});
	});
</script>
